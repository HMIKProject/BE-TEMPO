{
    "swagger": "2.0",
    "info": {
        "description": "API Dokumentasi untuk Backend Sistem Himpunan Mahasiswa Ilmu Komputer",
        "title": "HMIK CoreX API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/company-profile/team": {
            "get": {
                "description": "Mengembalikan semua data pengurus HMIK beserta keahlian dan minat risetnya",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Anggota"
                ],
                "summary": "Ambil daftar anggota tim HMIK",
                "responses": {
                    "200": {
                        "description": "Berhasil mengambil data",
                        "schema": {
                            "$ref": "#/definitions/github_com_HMIKProject_hmik-corex-backend_pkg_utils.JSendResponse"
                        }
                    },
                    "500": {
                        "description": "Gagal mengambil data dari server",
                        "schema": {
                            "$ref": "#/definitions/github_com_HMIKProject_hmik-corex-backend_pkg_utils.JSendResponse"
                        }
                    }
                }
            }
        },
        "/upload": {
            "post": {
                "description": "Menerima file form-data gambar dan mengunggahnya ke Cloudinary, mengembalikan URL gambar",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Upload"
                ],
                "summary": "Unggah gambar ke Cloudinary",
                "parameters": [
                    {
                        "type": "file",
                        "description": "File gambar yang akan diunggah",
                        "name": "image",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Folder tujuan di Cloudinary (opsional)",
                        "name": "folder",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Gambar berhasil diunggah",
                        "schema": {
                            "$ref": "#/definitions/github_com_HMIKProject_hmik-corex-backend_pkg_utils.JSendResponse"
                        }
                    },
                    "400": {
                        "description": "Input file tidak valid",
                        "schema": {
                            "$ref": "#/definitions/github_com_HMIKProject_hmik-corex-backend_pkg_utils.JSendResponse"
                        }
                    },
                    "500": {
                        "description": "Gagal mengunggah ke Cloudinary",
                        "schema": {
                            "$ref": "#/definitions/github_com_HMIKProject_hmik-corex-backend_pkg_utils.JSendResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "github_com_HMIKProject_hmik-corex-backend_pkg_utils.JSendResponse": {
            "type": "object",
            "properties": {
                "data": {},
                "errors": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "message": {
                    "type": "string"
                },
                "meta": {
                    "$ref": "#/definitions/github_com_HMIKProject_hmik-corex-backend_pkg_utils.Meta"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "github_com_HMIKProject_hmik-corex-backend_pkg_utils.Meta": {
            "type": "object",
            "properties": {
                "current_page": {
                    "type": "integer"
                },
                "limit_per_page": {
                    "type": "integer"
                },
                "total_data": {
                    "type": "integer"
                },
                "total_pages": {
                    "type": "integer"
                }
            }
        }
    }
}